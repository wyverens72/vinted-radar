PORT=3000
HOST=127.0.0.1
# Generate with: openssl rand -hex 24
APP_PASSWORD=replace-with-a-long-private-password
# Set true behind HTTPS in production
COOKIE_SECURE=false
PUBLIC_URL=http://localhost:3000
DATABASE_PATH=./data/radar.sqlite
# Optional until you create a Telegram bot
BOT_TOKEN=
TELEGRAM_OWNER_ID=
# demo or authorized-file. No Vinted credentials are used.
DATA_SOURCE=demo
AUTHORIZED_FEED_PATH=./data/authorized-feed.json
# Only set true after you establish permission for the feed
AUTHORIZED_FEED_CONFIRMED=false
