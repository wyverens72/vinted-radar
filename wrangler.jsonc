{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vinted-radar",
      "database_id": "83e6d278-304e-417a-925e-10c00bafe969",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "PUBLIC_REGISTRATION": "true",
    "DATA_SOURCE": "vinted-public",
    "CATALOG_FETCH_MODE": "github",
    "AUTHORIZED_FEED_CONFIRMED": "false",
    "PUBLIC_URL": "https://app.vinted-radar.workers.dev",
    "BOT_USERNAME": "SNvintedradarbot"
  },
  "observability": {
    "enabled": false
  }
}
