{
  "name": "vinted-radar",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "telegram:setup": "node --env-file=.env scripts/telegram-setup.js",
    "cloud:dev": "wrangler dev --port 8787 --test-scheduled",
    "cloud:db:local": "wrangler d1 migrations apply DB --local",
    "cloud:db:remote": "wrangler d1 migrations apply DB --remote",
    "cloud:deploy": "npm run build && wrangler deploy",
    "cloud:login": "wrangler login",
    "cloud:check": "wrangler deploy --dry-run --outdir ../../work/worker-build"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "vite": "^7.1.0",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "undici": "^7.30.1"
  }
}
